# Copy to `.env` for local dev, and set the same vars in
# Cloudflare Pages → Settings → Environment variables for production.
# Both are optional — the site builds and runs without them.

# Web3Forms access key — powers the contact form.
# Get a free key at https://web3forms.com (enter ryanlhanson@gmail.com; no account needed).
# Until this is set, the contact form tells visitors to email ryan@ldstn.us directly.
PUBLIC_WEB3FORMS_KEY=

# Cloudflare Web Analytics beacon token — privacy-friendly, no cookies.
# Optional: you can instead enable Web Analytics in the Cloudflare dashboard
# with zero code once the domain is proxied through Cloudflare.
PUBLIC_CF_BEACON_TOKEN=
