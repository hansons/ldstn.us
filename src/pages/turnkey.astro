---
import Base from '../layouts/Base.astro';

const description =
  'Turnkey institutional systems: we do the discovery, audit, knowledge capture, methodology, and role library, then ship you a configured machine with everything loaded and ready. You own it — no recurring contract required.';
---
<Base title="Turnkey institutional systems" description={description}>
  <section class="page-head">
    <div class="wrap">
      <p class="crumbs"><a href="/">Home</a><span class="sep">/</span><span class="here">Turnkey</span></p>
      <h1>Turnkey institutional systems</h1>
      <p class="lede">For organizations that want institutional clarity, but don't want the project required to get there.</p>
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <p class="turnkey-pitch">
        We do all the work — discovery interviews, audit, knowledge capture, methodology codification, role library —
        and ship you a configured machine with everything loaded, indexed, and ready to use.
        <strong>It's yours. No recurring contract required.</strong> Instead of teaching your team to do the work,
        we do it, and they receive the result.
      </p>

      <div class="turnkey-grid">
        <div class="turnkey-main">
          <h3>What's included</h3>
          <ul>
            <li><strong>The hard grind, done.</strong> Discovery interviews, audit fieldwork, knowledge capture, methodology codification, role library tailored to your org.</li>
            <li><strong>A configured machine.</strong> Hardware sized to your scope (workstation, small server, or rugged appliance), VS Code + Claude Code installed and tuned to the work.</li>
            <li><strong>Your data, loaded.</strong> SOPs, regulations, decisions, methodology — captured, structured, indexed, version-controlled, ready on day one.</li>
            <li><strong>Custom role library.</strong> AI personas tuned to your decision style, regulatory environment, and vocabulary.</li>
            <li><strong>Maintenance &amp; migration docs.</strong> Your IT lead can keep it running, refresh hardware, or move it — without us.</li>
            <li><strong>Kickoff training.</strong> Your operators learn how to use what we built, with documentation they can return to.</li>
            <li><strong>Prompt engineering session.</strong> A working session on getting good results out of the system — not just how to use it, but how to ask it questions that produce useful answers.</li>
          </ul>
        </div>

        <aside class="turnkey-side">
          <div class="turnkey-block">
            <h3>How it works</h3>
            <ol>
              <li>Discovery &amp; scoping</li>
              <li>Build: capture, audit, configure, provision hardware</li>
              <li>Delivery: onsite setup or shipped, with kickoff training</li>
              <li>Done — you own it</li>
            </ol>
          </div>

          <div class="turnkey-block">
            <h3>Pricing</h3>
            <ul class="turnkey-tiers">
              <li><span class="tier-name">Small problem</span><span class="tier-price">$15K</span></li>
              <li><span class="tier-name">Medium problem</span><span class="tier-price">$80K</span></li>
              <li><span class="tier-name">Big problem</span><span class="tier-price">$200K+</span></li>
            </ul>
            <p class="footnote">One-time. Tier depends on organizational complexity, document volume, and regulatory surface. Hardware passed through at cost or billed separately.</p>
          </div>

          <div class="turnkey-block turnkey-optional">
            <h3>Optional ongoing service</h3>
            <p>Available if you want a prompt operator on call, methodology updates as your operation evolves, or new roles added as needs emerge. Most clients run with what we deliver.</p>
            <p class="turnkey-price">From <strong>$2K–$8K/month</strong></p>
            <p class="footnote">Three tiers based on operator hours and response SLA. Cancel with 30 days' notice.</p>
          </div>
        </aside>
      </div>
    </div>
  </section>

  <section class="cta-band">
    <div class="wrap">
      <h2>Tell us the problem. We'll deliver the system.</h2>
      <p>Turnkey starts with the same 30-minute intro call. We scope it, price it, build it, and hand you the keys.</p>
      <p class="cta-actions">
        <a href="/contact" class="btn">Start a conversation</a>
        <a href="/services" class="btn-ghost">See the underlying work</a>
      </p>
    </div>
  </section>
</Base>
