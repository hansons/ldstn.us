---
import Base from '../layouts/Base.astro';

const description =
  'How a Lodestone engagement works, start to finish: intro call, NDA, discovery and scope, Statement of Work, execution, and closeout with knowledge transfer. Same structure every time, adapted to the size of the work.';
---
<Base title="Approach" description={description}>
  <section class="page-head">
    <div class="wrap">
      <p class="crumbs"><a href="/">Home</a><span class="sep">/</span><span class="here">Approach</span></p>
      <h1>How engagements work</h1>
      <p class="lede">Same structure every time, adapted in formality to the size of the work — a two-hour consult and a six-figure turnkey build follow the same spine.</p>
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <ol class="steps">
        <li>
          <span class="step-num">01</span>
          <div>
            <h3>Intro call</h3>
            <p>Thirty minutes. No charge. We figure out whether there's a fit worth exploring before anyone commits to anything.</p>
            <p class="step-actions">
              <a href="tel:+15419087501" class="btn-inline">Call 541.908.7501</a>
              <a href="mailto:ryan@ldstn.us" class="btn-inline btn-inline-ghost">Email ryan@ldstn.us</a>
            </p>
          </div>
        </li>
        <li>
          <span class="step-num">02</span>
          <div>
            <h3>NDA, if you need one</h3>
            <p>Mutual, simple, executed before any proprietary discussion. Skip it when there's nothing sensitive yet.</p>
          </div>
        </li>
        <li>
          <span class="step-num">03</span>
          <div>
            <h3>Discovery and scope</h3>
            <p>One or more working sessions to understand the problem, the systems, and the constraints. We surface what's in scope, what's out, and what's deferred — in writing — before quoting.</p>
          </div>
        </li>
        <li>
          <span class="step-num">04</span>
          <div>
            <h3>Statement of Work</h3>
            <p>Clear deliverables, timeline, and price. Fixed-price when scope is clear; time-and-materials when it isn't. No surprise bills — scope changes go through written change orders.</p>
          </div>
        </li>
        <li>
          <span class="step-num">05</span>
          <div>
            <h3>Execution</h3>
            <p>Onsite days, sprints, or retainer cadence — whichever shape fits. Status updates on the cadence you want. Acceptance windows and revision rounds are spelled out in the SOW.</p>
          </div>
        </li>
        <li>
          <span class="step-num">06</span>
          <div>
            <h3>Closeout</h3>
            <p>Final deliverable accepted. Knowledge transfer to the person who'll own it after we leave. Sixty-day warranty on material defects.</p>
          </div>
        </li>
      </ol>
    </div>
  </section>

  <section class="cta-band">
    <div class="wrap">
      <h2>Start at step one.</h2>
      <p>A 30-minute intro call costs nothing and commits you to nothing. Worst case, you get a straight answer about whether we're the right fit.</p>
      <p class="cta-actions">
        <a href="/contact" class="btn">Book an intro call</a>
        <a href="/pricing" class="btn-ghost">See pricing</a>
      </p>
    </div>
  </section>
</Base>
