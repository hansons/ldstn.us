---
import Base from '../../layouts/Base.astro';
import { services } from '../../data/services.js';

const description =
  'Six lanes of institutional consulting: knowledge capture, audits and actionable intelligence, document production, systems and requirements engineering, AI-leveraged operations, and compliance-aware delivery.';
---
<Base title="Services" description={description}>
  <section class="page-head">
    <div class="wrap">
      <p class="crumbs"><a href="/">Home</a><span class="sep">/</span><span class="here">Services</span></p>
      <h1>What we do</h1>
      <p class="lede">Six lanes of work. Most engagements draw on more than one — an audit that turns into knowledge capture, a spec that needs the compliance frame built in from the start.</p>
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <div class="cards">
        {services.map((s) => (
          <a class="card card-link" href={`/services/${s.slug}`}>
            <h3>{s.name}</h3>
            <p>{s.summary}</p>
            <span class="card-more">
              Explore
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>
            </span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="cta-band">
    <div class="wrap">
      <h2>Not sure which lane you're in?</h2>
      <p>Most engagements cross a few. Tell us the problem and we'll tell you what it actually takes.</p>
      <p class="cta-actions">
        <a href="/contact" class="btn">Start a conversation</a>
        <a href="/pricing" class="btn-ghost">See pricing</a>
      </p>
    </div>
  </section>
</Base>
