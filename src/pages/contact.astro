---
import Base from '../layouts/Base.astro';
import ContactForm from '../components/ContactForm.astro';

const description =
  'Start a conversation with Lodestone Consulting. Discovery calls are 30 minutes, no charge. Email ryan@ldstn.us or call 541.908.7501. Corvallis, Oregon — remote-first, travel available.';
---
<Base title="Contact" description={description}>
  <section class="page-head">
    <div class="wrap">
      <p class="crumbs"><a href="/">Home</a><span class="sep">/</span><span class="here">Contact</span></p>
      <h1>Start a conversation</h1>
      <p class="lede">Tell us what you're trying to figure out. Discovery calls are 30 minutes, no charge, no commitment.</p>
    </div>
  </section>

  <section class="section">
    <div class="wrap contact-layout">
      <div>
        <ContactForm />
      </div>

      <aside class="contact-side">
        <div class="meta">
          <h3>Reach us directly</h3>
          <ul class="contact-list">
            <li>
              <a href="mailto:ryan@ldstn.us">
                <svg class="contact-icon" viewBox="0 0 24 24" aria-hidden="true">
                  <rect x="3" y="5" width="18" height="14" rx="2" fill="none" stroke="currentColor" stroke-width="2"/>
                  <path d="M3 7l9 6 9-6" fill="none" stroke="currentColor" stroke-width="2" stroke-linejoin="round" stroke-linecap="round"/>
                </svg>
                <span>ryan@ldstn.us</span>
              </a>
            </li>
            <li>
              <a href="tel:+15419087501">
                <svg class="contact-icon" viewBox="0 0 24 24" aria-hidden="true">
                  <path fill="currentColor" d="M20.01 15.38c-1.23 0-2.42-.2-3.53-.56-.35-.12-.74-.03-1.01.24l-1.57 1.97c-2.83-1.35-5.48-3.9-6.89-6.83l1.95-1.66c.27-.28.35-.67.24-1.02-.37-1.11-.56-2.3-.56-3.53 0-.54-.45-.99-.99-.99H4.19C3.65 3 3 3.24 3 3.99 3 13.28 10.73 21 20.01 21c.71 0 .99-.63.99-1.18v-3.45c0-.54-.45-.99-.99-.99z"/>
                </svg>
                <span>541.908.7501</span>
              </a>
            </li>
            <li>
              <a href="https://www.linkedin.com/in/ryan-hanson-0a766b30/" target="_blank" rel="noopener">
                <svg class="contact-icon" viewBox="0 0 24 24" aria-hidden="true">
                  <path fill="currentColor" d="M19 0h-14c-2.761 0-5 2.239-5 5v14c0 2.761 2.239 5 5 5h14c2.762 0 5-2.239 5-5v-14c0-2.761-2.238-5-5-5zm-11 19h-3v-11h3v11zm-1.5-12.268c-.966 0-1.75-.79-1.75-1.764s.784-1.764 1.75-1.764 1.75.79 1.75 1.764-.783 1.764-1.75 1.764zm13.5 12.268h-3v-5.604c0-3.368-4-3.113-4 0v5.604h-3v-11h3v1.765c1.396-2.586 7-2.777 7 2.476v6.759z"/>
                </svg>
                <span>Ryan Hanson · LinkedIn</span>
              </a>
            </li>
          </ul>
        </div>
        <div class="meta">
          <h3>Location</h3>
          <p style="margin:0;font-size:1rem;">Corvallis, Oregon<br/><span class="muted" style="font-size:0.9rem;">Remote-first, travel available</span></p>
        </div>
      </aside>
    </div>
  </section>
</Base>
