---
// Web3Forms — set PUBLIC_WEB3FORMS_KEY in the Cloudflare Pages env (or a local
// .env). Get a free key at https://web3forms.com (enter ryanlhanson@gmail.com,
// no account needed). Until it's set, the form shows a "email directly" notice.
const accessKey = import.meta.env.PUBLIC_WEB3FORMS_KEY || '';
---
<form class="contact-form" id="contact-form" action="https://api.web3forms.com/submit" method="POST">
  <input type="hidden" name="access_key" value={accessKey} />
  <input type="hidden" name="subject" value="New inquiry from ldstn.us" />
  <input type="hidden" name="from_name" value="ldstn.us contact form" />
  <!-- honeypot: bots fill this, humans never see it -->
  <input type="checkbox" name="botcheck" class="hp" tabindex="-1" autocomplete="off" aria-hidden="true" />

  <div class="field-row">
    <div class="field">
      <label for="cf-name">Name <span class="req">*</span></label>
      <input id="cf-name" type="text" name="name" required autocomplete="name" />
    </div>
    <div class="field">
      <label for="cf-email">Email <span class="req">*</span></label>
      <input id="cf-email" type="email" name="email" required autocomplete="email" />
    </div>
  </div>

  <div class="field">
    <label for="cf-org">Organization</label>
    <input id="cf-org" type="text" name="organization" autocomplete="organization" />
  </div>

  <div class="field">
    <label for="cf-topic">What are you trying to figure out? <span class="req">*</span></label>
    <textarea id="cf-topic" name="message" required
      placeholder="A few sentences on the problem, roughly when you'd want to start, and what a good outcome looks like."></textarea>
  </div>

  <div class="form-actions">
    <button type="submit" class="btn">Send message</button>
    <p class="form-note">Intro calls are 30 minutes, no charge. We reply within one business day.</p>
  </div>

  <p class="form-status" id="form-status" role="status" aria-live="polite" hidden></p>
</form>

<script is:inline>
  (function () {
    var form = document.getElementById('contact-form');
    var status = document.getElementById('form-status');
    if (!form) return;
    form.addEventListener('submit', async function (e) {
      e.preventDefault();
      var btn = form.querySelector('button[type="submit"]');
      var key = form.querySelector('input[name="access_key"]').value;
      status.hidden = false;
      status.className = 'form-status';
      if (!key) {
        status.classList.add('is-error');
        status.innerHTML = 'The form isn’t wired up yet — please email <a href="mailto:ryan@ldstn.us">ryan@ldstn.us</a> directly.';
        return;
      }
      var prev = btn.textContent;
      btn.disabled = true;
      btn.textContent = 'Sending…';
      try {
        var res = await fetch(form.action, {
          method: 'POST',
          body: new FormData(form),
          headers: { Accept: 'application/json' },
        });
        var data = await res.json();
        if (data.success) {
          form.reset();
          status.classList.add('is-success');
          status.textContent = 'Thanks — your message is in. We’ll reply within one business day.';
        } else {
          throw new Error(data.message || 'failed');
        }
      } catch (err) {
        status.classList.add('is-error');
        status.innerHTML = 'Something went wrong. Please email <a href="mailto:ryan@ldstn.us">ryan@ldstn.us</a> directly.';
      } finally {
        btn.disabled = false;
        btn.textContent = prev;
      }
    });
  })();
</script>
